# CampusFind - Application Configuration Template
# Copy this file to .env and adjust variables as needed

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Database Settings
# Set DB_TYPE to 'sqlite' for zero-config local testing, or 'mysql' for MySQL server
DB_TYPE=sqlite
DB_NAME=campusfind
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# SQLite fallback path (used when DB_TYPE=sqlite or MySQL is unavailable)
SQLITE_PATH=campusfind.db

# Admin Initial Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@campusfind.edu
DEFAULT_ADMIN_PASSWORD=Admin@CampusFind2026
DEFAULT_ADMIN_NAME=Campus Administrator
